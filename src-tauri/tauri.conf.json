{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Utter",
  "version": "0.1.0",
  "identifier": "dev.utter.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "title": "Utter",
        "url": "index.html",
        "width": 760,
        "height": 820,
        "minWidth": 620,
        "minHeight": 560,
        "center": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Utter dictation",
        "url": "overlay.html",
        "width": 360,
        "height": 60,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Context-aware voice typing with your own API keys",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
